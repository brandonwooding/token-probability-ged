#!/bin/bash
# MultiGED unlabelled-test predictions by instruction (no threshold: the model
# emits c/i directly). One job, six datasets back to back; each writes its own
# run folder as it finishes, so an overrun costs only the in-flight dataset.
# Sizing: FCE-dev's 2,191 sentences took ~39 min on gemma-4-12B-it, so the 13,689
# test sentences are ~4 h plus six vLLM start-ups; 12 h leaves ample margin
# (walltime is not a term in the queue sort formula, and a running job cannot be
# lengthened).
#PBS -l walltime=12:00:00
#PBS -l select=1:ncpus=4:mem=64gb:ngpus=1:gpu_type=A100
#PBS -N ged_instr_test
#PBS -j oe
mkdir -p ~/logs

# Submit from the repository root: qsub <dir>/<script>.pbs
PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-$(pwd)}}"
cd "$PROJECT_ROOT"
module load Python/3.12.3-GCCcore-13.3.0
source "$PROJECT_ROOT/.venv/bin/activate"
export CUDA_VISIBLE_DEVICES=$(nvidia-smi --query-gpu=index --format=csv,noheader | tr '\n' ',' | sed 's/,$//')
export VLLM_USE_FLASHINFER_SAMPLER=0

MODEL="${MODEL:-google/gemma-4-12B-it}"
DATASETS=(
  czech/cs_geccc_test_unlabelled
  english/en_fce_test_unlabelled
  english/en_realec_test_unlabelled
  german/de_falko-merlin_test_unlabelled
  italian/it_merlin_test_unlabelled
  swedish/sv_swell_test_unlabelled
)
for DS in "${DATASETS[@]}"; do
  python "$PROJECT_ROOT/GED-by-instruction/ged_inference.py" \
    --dataset "$DS" --model "$MODEL"
done
