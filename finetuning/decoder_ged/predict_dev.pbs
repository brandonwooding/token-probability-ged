#!/bin/bash
#PBS -l walltime=24:00:00
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1:gpu_type=A100
#PBS -N decoder_ged_predict_dev
#PBS -j oe

# Submit from the repository root: qsub <dir>/<script>.pbs
PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-$(pwd)}}"
cd "$PROJECT_ROOT"
module load Python/3.12.3-GCCcore-13.3.0
source "$PROJECT_ROOT/.venv/bin/activate"
export CUDA_VISIBLE_DEVICES=$(nvidia-smi --query-gpu=index --format=csv,noheader | tr '\n' ',' | sed 's/,$//')

RUN="${RUN:?submit with RUN=/absolute/path/to/family-d-run}"
MAX_LENGTH="${MAX_LENGTH:-512}"
# The decoder evaluation matrix is the six authentic MultiGED dev corpora plus
# the two C4_200M eval5k corpora used for synthetic threshold calibration.
DATASETS="${DATASETS:-czech/cs_geccc_dev english/en_fce_dev english/en_realec_dev german/de_falko-merlin_dev italian/it_merlin_dev swedish/sv_swell_dev english/en_c4200_eval5k german/de_c4200_eval5k}"
read -r -a DATASET_ARGS <<< "$DATASETS"

python "$PROJECT_ROOT/finetuning/decoder_ged/predict_head.py" \
  --run "$RUN" --max-length "$MAX_LENGTH" --dataset "${DATASET_ARGS[@]}"
