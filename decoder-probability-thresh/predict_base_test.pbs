#!/bin/bash
# Base (no adapter) fewshot test-set probabilities for the six MultiGED test sets.
# Models run sequentially in one job: ~20 min gemma-4-12B + ~45 min Qwen3.5-9B-Base
# at the measured 0.085 / 0.20 s per sentence over 13,689 sentences.
#PBS -l walltime=04:00:00
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1:gpu_type=A100
#PBS -N base_fewshot_test
#PBS -j oe

# Submit from the repository root: qsub <dir>/<script>.pbs
PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-$(pwd)}}"
cd "$PROJECT_ROOT"
module load Python/3.12.3-GCCcore-13.3.0
source "$PROJECT_ROOT/.venv/bin/activate"
export CUDA_VISIBLE_DEVICES=$(nvidia-smi --query-gpu=index --format=csv,noheader | tr '\n' ',' | sed 's/,$//')

MODELS="${MODELS:-google/gemma-4-12B Qwen/Qwen3.5-9B-Base}"
DATASETS=(
  czech/cs_geccc_test_unlabelled
  english/en_fce_test_unlabelled
  english/en_realec_test_unlabelled
  german/de_falko-merlin_test_unlabelled
  italian/it_merlin_test_unlabelled
  swedish/sv_swell_test_unlabelled
)
# Each (model, dataset) writes its own run folder as it finishes.
for MODEL in $MODELS; do
  for DS in "${DATASETS[@]}"; do
    python "$PROJECT_ROOT/decoder-probability-thresh/llm-decoder-threshold.py" \
      --dataset "$DS" --model "$MODEL" --template fewshot
  done
done
