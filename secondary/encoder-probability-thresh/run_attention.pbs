#!/bin/bash
#PBS -l walltime=02:00:00
#PBS -l select=1:ncpus=4:mem=32gb:ngpus=1:gpu_type=L40S
#PBS -N run_attention
#PBS -j oe
mkdir -p ~/logs

# Submit from the repository root: qsub <dir>/<script>.pbs
PROJECT_ROOT="${PROJECT_ROOT:-${PBS_O_WORKDIR:-$(pwd)}}"
cd "$PROJECT_ROOT"

module load Python/3.12.3-GCCcore-13.3.0
source "$PROJECT_ROOT/.venv/bin/activate"

export CUDA_VISIBLE_DEVICES=$(nvidia-smi --query-gpu=index --format=csv,noheader | tr '\n' ',' | sed 's/,$//')

# mmBERT-base by default, matching run_encoder_thresh.pbs, so the attention
# features and the probability features come from the same encoder and the
# multilingual comparison stays available. Pass MODEL=answerdotai/ModernBERT-base
# for the English-only baseline.
MODEL="${MODEL:-jhu-clsp/mmBERT-base}"
DATASET="${DATASET:-english/en_fce_dev}"

python "$PROJECT_ROOT/secondary/encoder-probability-thresh/extract-attention.py" \
    --dataset "$DATASET" --model "$MODEL"
